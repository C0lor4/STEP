{
  "manifest_version": 3,
  "name": "Focus Bypass",
  "version": "1.1",
  "description": "Prevents websites from detecting tab switches or window unfocus",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}
